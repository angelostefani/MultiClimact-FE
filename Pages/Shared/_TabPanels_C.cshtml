<div class="tab-pane fade" id="panelC2" role="tabpanel" aria-labelledby="tabC2-tab">
    <div class="map-checkbox-container" id="panelC2-layout">

        <!-- MAPPA (85%) -->
        <div id="mapC2" class="map-container-85"></div>

        <!-- SIDEBAR (15%) -->
        <aside class="layer-sidebar">
            <div class="layer-controls-card layer-controls-card--sidebar">
                <div class="layer-controls-card__header">
                    <!-- titolo rimosso -->
                </div>

                <div class="layer-box">
                    <div class="layer-box__title">Input</div>
                    <div class="layer-box__body">
                        <label class="layer-toggle">
                            <input type="checkbox" id="checkboxC2_1" checked
                                onclick="toggleLayer(configWMSMatrixMapC2, 0, mapC2, this.checked)">
                            <span class="layer-label">Camerino Buildings</span>
                        </label>

                        <label class="layer-toggle">
                            <input type="checkbox" id="checkboxC2_3" checked
                                onclick="toggleLayerBlock(configWMSMatrixMapC2, 5, mapC2, 5, 1, this.checked)">
                            <span class="layer-label">Marche Buildings</span>
                        </label>
                    </div>
                </div>

                <div class="layer-box">
                    <div class="layer-box__title">Camerino Buildings</div>
                    <div class="layer-box__body">
                        <label class="layer-toggle">
                            <input type="checkbox" id="checkboxC2_2" checked
                                onclick="toggleLayerBlock(configWMSMatrixMapC2, 0, mapC2, 5, 1, this.checked)">
                            <span class="layer-label">Seismic Vulnerabilty</span>
                        </label>

                        <label class="layer-toggle">
                            <input type="checkbox" id="checkboxC2_4" checked
                                onclick="toggleLayerBlock(configWMSMatrixMapC2, 2, mapC2, 5, 1, this.checked)">
                            <span class="layer-label">Damage State Probabilty</span>
                        </label>

                        <label class="layer-toggle">
                            <input type="checkbox" id="checkboxC2_5" checked
                                onclick="toggleLayerBlock(configWMSMatrixMapC2, 3, mapC2, 5, 1, this.checked)">
                            <span class="layer-label">Shakemap</span>
                        </label>
                    </div>
                </div>

                <div class="layer-box">
                    <div class="layer-box__title">Marche Region Building</div>
                    <div class="layer-box__body">
                        <label class="layer-toggle">
                            <input type="checkbox" id="checkboxC2_7" checked
                                onclick="toggleLayerBlock(configWMSMatrixMapC2, 1, mapC2, 5, 1, this.checked)">
                            <span class="layer-label">Seismic Vulnerability</span>
                        </label>

                        <label class="layer-toggle">
                            <input type="checkbox" id="checkboxC2_8" checked
                                onclick="toggleLayerBlock(configWMSMatrixMapC2, 4, mapC2, 5, 1, this.checked)">
                            <span class="layer-label">Damage State Probability</span>
                        </label>
                    </div>
                </div>
            </div>
        </aside>
    </div>
    <!-- Radio button sotto alla mappa -->
    <div class="radio-container">
        <label>
            <input type="radio" name="layerC2" id="layerC2_1" checked
                onclick="switchLayers(configWMSMatrixMapC2, 0, mapC2, 5, 1)"> Pd1
        </label>
        <label>
            <input type="radio" name="layerC2" id="layerC2_2" onclick="switchLayers(configWMSMatrixMapC2, 1, mapC2, 5, 1)">
            Pd2
        </label>
        <label>
            <input type="radio" name="layerC2" id="layerC2_3" onclick="switchLayers(configWMSMatrixMapC2, 2, mapC2, 5, 1)">
            Pd3
        </label>
        <label>
            <input type="radio" name="layerC2" id="layerC2_4" onclick="switchLayers(configWMSMatrixMapC2, 3, mapC2, 5, 1)">
            Pd4
        </label>
        <label>
            <input type="radio" name="layerC2" id="layerC2_5" onclick="switchLayers(configWMSMatrixMapC2, 4, mapC2, 5, 1)">
            Pd5
        </label>
    </div>
</div>

