@page
@model MultiClimact.Pages.NewConfigurationModel
@{
    ViewData["Title"] = "Configuration - New Configuration";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/new-configuration.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/lint/lint.min.css" />
}

<div class="mb-3">
    @await Html.PartialAsync("_PageMenu")
</div>

<div class="container-fluid" style="padding-left: 8px; padding-right: 4px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb" id="breadcrumb">
            <li class="breadcrumb-item"><a class="link-primary text-decoration-none" href="/">Home</a></li>
            <li class="breadcrumb-item"><a class="link-primary text-decoration-none" href="#">Configuration settings</a></li>
            <li class="breadcrumb-item"><a class="link-primary text-decoration-none" asp-page="/Shared/VulnerabilitySettings">Default configurations</a></li>
            <li class="breadcrumb-item active" aria-current="page">New Configuration</li>
        </ol>
    </nav>
</div>

<div class="container py-3 new-config-page">
    <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
        <div>
            <p class="text-uppercase text-muted small mb-1">Configuration settings</p>
            <h1 class="h3 fw-bold mb-1">New Configuration</h1>
            <p class="text-muted mb-0">Load the default vulnerability JSON for a hazard type, edit it, and save it as the new default.</p>
        </div>
        <a class="btn btn-outline-secondary align-self-start align-self-lg-end" asp-page="/Shared/VulnerabilitySettings">&larr; Back to default configurations</a>
    </div>

    <div class="card shadow-sm border-0 new-config-card">
        <div class="card-body p-4">
            <div class="new-config-toolbar">
                <div class="new-config-field">
                    <label class="form-label fw-semibold" for="haztypeId">Hazard type</label>
                    <select class="form-select" id="haztypeId">
                        <option value="1">1 - Earthquake</option>
                        <option value="3">3 - Heat wave</option>
                        <option value="4">4 - Extreme precipitation</option>
                    </select>
                </div>
                <div class="new-config-field new-config-field--wide">
                    <label class="form-label fw-semibold" for="configurationDescription">Description</label>
                    <input type="text" class="form-control" id="configurationDescription" placeholder="Default vulnerability description" />
                </div>
                <div class="new-config-actions">
                    <button type="button" class="btn btn-success" id="saveConfigurationButton">Save</button>
                </div>
            </div>

            <div class="new-config-status alert alert-info mb-3" id="newConfigStatus" role="status">
                Loading default configuration...
            </div>

            <div class="new-config-editor-shell">
                <div class="new-config-editor-header">
                    <div class="new-config-editor-title">Default vulnerability JSON</div>
                </div>
                <div class="new-config-editor-wrap">
                    <textarea
                        class="form-control form-control-sm dep-json-editor new-config-editor"
                        id="configurationJson"
                        rows="12"
                        spellcheck="false"
                        data-status-id="newConfigJsonStatus"
                        aria-describedby="configurationHelp"></textarea>
                </div>
                <div class="new-config-editor-footer">
                    <div class="new-config-json-status dep-status" id="newConfigJsonStatus">
                        <span class="dep-status-dot dep-status-dot--invalid"></span>
                        <span class="dep-status-text dep-status-text--invalid">Syntax Error</span>
                    </div>
                    <div id="configurationHelp" class="form-text mb-0">
                        The content must be valid JSON before it can be saved.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="centerPanel" class="center-panel">
    <div id="legendContainer" class="legend-container">
        <h4 class="panel-title">Legends</h4>
    </div>
</div>

<div id="chatPanel" class="chat-panel" style="display:none;">
    <div class="chat-container">
        <h4 class="chat-title">Ask for help</h4>
        <div id="chatMessages" class="chat-messages"></div>
        <div class="chat-input-container">
            <input type="text" id="chatInput" class="chat-input" placeholder="Write your question..." />
            <button class="chat-send-button" type="button">Send</button>
        </div>
    </div>
</div>

<div id="mySidebarRight" class="sidebar-right fixed-sidebar">
    <div class="icon-container">
        <div class="icon-wrapper legend-icon-wrapper">
            <i class="bi bi-map map-icon"></i>
        </div>
        <div class="icon-wrapper globe-icon-wrapper">
            <i class="bi bi-globe-europe-africa globe-icon"></i>
        </div>
        <div class="icon-wrapper robot-icon-wrapper">
            <i class="bi bi-robot"></i>
        </div>
        <div id="hazardBottomToggle" class="icon-wrapper hazard-toggle-wrapper" onclick="toggleBottomBar()" title="Hazard Selector">
            <i class="bi bi-cloud-lightning-rain"></i>
        </div>
        <div id="graphBottomToggle" class="icon-wrapper graph-toggle-wrapper" onclick="toggleGraphBottomBar()" title="Scenario Selector">
            <i class="bi bi-graph-up-arrow"></i>
        </div>
    </div>
</div>

@await Html.PartialAsync("_BottomBar")
@await Html.PartialAsync("_BottomBarGraph")

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/lint/lint.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsonlint/1.6.0/jsonlint.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/lint/json-lint.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/earthquake-helper.js" asp-append-version="true"></script>
    <script src="~/js/graph-helper.js" asp-append-version="true"></script>
    <script src="~/js/fixedSidebar-helper.js" asp-append-version="true"></script>
    <script src="~/js/NewConfiguration.js" asp-append-version="true"></script>
}
