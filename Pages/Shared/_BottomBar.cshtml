<div id="myBottomBar" class="bottom-bar">
    <div class="bottom-bar-content">
        <!-- Hazard Search Form -->
        <div class="bottom-bar-search-wrap mx-4">
            <form id="hazardForm" class="bottom-bar-search-card p-3" method="GET" onsubmit="fetchHazardData(event)">
                <input type="hidden" name="user_id" value="system">

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label for="startDate" class="form-label">Start Date</label>
                        <input type="date" class="form-control" id="startDate" name="start_date" value="2024-10-01" placeholder="2024-10-01">
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="endDate" class="form-label">End Date</label>
                        <input type="date" class="form-control" id="endDate" name="end_date" value="@DateTime.Today.ToString("yyyy-MM-dd")" placeholder="@DateTime.Today.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="hazardType" class="form-label">Hazard</label>
                        <select class="form-control" id="hazardType" name="hazard_type">
                            <option value="earthquake" selected>Earthquake</option>
                            <option value="heatwave">Heatwave</option>
                            <option value="extremeprecipitation">Extreme precipitation</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="simulated" class="form-label">Event source</label>
                        <select class="form-control" id="simulated" name="simulated">
                            <option value="false" selected>Observed</option>
                            <option value="true">Simulated</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary bottom-bar-search-btn">
                            <i class="bi bi-search"></i>
                            <span>Search</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Hazard Results Table -->
        <div id="hazardResults" class="mt-4 mx-4">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>id_run</th>
                        <th>Occurrence Time</th>
                        <th>Description</th>
                        <th>Hazard</th>
                    </tr>
                </thead>
                <tbody id="hazardTableBody">
                    <!-- Results will be populated here -->
                </tbody>
            </table>
            <div id="paginationControls" class="mt-3"></div>
        </div>

    </div>
</div>
